# Ignore everything
*

# But descend into directories
!*/

# but still exclude generated folders
*.egg-info/
*.ipynb_checkpoints/
*.pnp
*.venv
*coverage
*build
*dist

# And permit certain files
!.dockerignore
!.env.example
!.gitignore
!.python-version
!Dockerfile
!LICENSE
!uv.lock

# And filetypes
!*.md
!*.py
!*.toml
!*.yaml

# But never secrets or dlt local state
secrets.toml
*.secrets.toml
.dlt/profile-name
.dlt/state/
.dlt/data/
