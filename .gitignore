# Ignore everything
*

# But descend into directories
!*/

# but still exclude generated folders
*.egg-info/
*.ipynb_checkpoints/
*.pnp
*.venv
*coverage
*build
*dist
target/
logs/
dbt_packages/

# And permit certain files
!.dockerignore
!.env.example
!.gitignore
!.python-version
!Dockerfile
!LICENSE
!uv.lock

# And filetypes
!*.md
!*.py
!*.sql
!*.toml
!*.yaml
!*.yml

# But never secrets or local tool state
.user.yml
secrets.toml
*.secrets.toml
.dlt/profile-name
.dlt/state/
.dlt/data/
